  "info": {
    "title": "AI Control Center",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/dashboard/snapshot": {
      "get": {
        "operationId": "dashboard_snapshot",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardSnapshot"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Snapshot",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
