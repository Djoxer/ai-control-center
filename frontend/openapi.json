    }
  },
  "info": {
    "title": "AI Control Center",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "core_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "core"
        ]
      }
    },
    "/api/v1/logs/entries": {
      "get": {
        "operationId": "logs_entries",
        "parameters": [
          {
            "description": "source key from /sources, e.g. control-center",
            "in": "query",
            "name": "source",
            "required": true,
            "schema": {
              "description": "source key from /sources, e.g. control-center",
              "title": "Source",
              "type": "string"
            }
          },
          {
            "description": "minimum level; hides lines without a level",
            "in": "query",
            "name": "level",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "DEBUG",
                    "INFO",
                    "WARNING",
                    "ERROR",
                    "CRITICAL"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "minimum level; hides lines without a level",
              "title": "Level"
            }
          },
          {
            "description": "logger prefix, e.g. control_center.modules.logs",
            "in": "query",
            "name": "logger",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "logger prefix, e.g. control_center.modules.logs",
              "title": "Logger"
            }
          },
          {
            "description": "logger prefixes to hide, e.g. uvicorn.access",
            "in": "query",
            "name": "exclude",
            "required": false,
            "schema": {
              "description": "logger prefixes to hide, e.g. uvicorn.access",
              "items": {
                "type": "string"
              },
              "title": "Exclude",
              "type": "array"
            }
          },
          {
            "description": "case-insensitive text search",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "case-insensitive text search",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "in": "query",
            "name": "until",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Until"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "nextCursor of the previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "nextCursor of the previous page",
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Entries",
        "tags": [
          "logs"
        ]
      }
    },
    "/api/v1/logs/sources": {
      "get": {
        "operationId": "logs_sources",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LogSourceInfo"
                  },
                  "title": "Response Logs Sources",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Sources",
        "tags": [
          "logs"
        ]
      }
    },
    "/api/v1/meta/modules": {
      "get": {
        "description": "The Angular shell builds its menu from this - disabled or failed modules show up greyed out.",
        "operationId": "core_modules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModuleInfo"
                  },
                  "title": "Response Core Modules",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Modules",
        "tags": [
          "core"
        ]
      }
    }
  }
}
