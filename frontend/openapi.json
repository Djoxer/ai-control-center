  "info": {
    "title": "AI Control Center",
    "version": "0.5.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/dashboard/events": {
      "get": {
        "operationId": "dashboard_events",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "nextBefore of the previous page",
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "nextBefore of the previous page",
              "title": "Before"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Events",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/api/v1/dashboard/history": {
      "get": {
        "operationId": "dashboard_history",
        "parameters": [
          {
            "description": "time span back from now",
            "in": "query",
            "name": "range",
            "required": false,
            "schema": {
              "default": "1h",
              "description": "time span back from now",
              "enum": [
                "1h",
                "6h",
                "24h",
                "7d",
                "30d"
              ],
              "title": "Range",
              "type": "string"
            }
          },
          {
            "description": "empty = all metrics",
            "in": "query",
            "name": "metrics",
            "required": false,
            "schema": {
              "description": "empty = all metrics",
              "items": {
                "enum": [
                  "gpu_util",
                  "vram_used_mib",
                  "temp_c",
                  "power_w",
                  "cpu_percent",
                  "ram_percent"
                ],
                "type": "string"
              },
              "title": "Metrics",
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardHistory"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "History",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/api/v1/dashboard/snapshot": {
      "get": {
        "operationId": "dashboard_snapshot",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardSnapshot"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Snapshot",
        "tags": [
          "dashboard"
        ]
      }
    },
