          },
          "httpStatus": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Httpstatus"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "latencyMs": {
            "anyOf": [
