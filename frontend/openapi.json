{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthInfo": {
        "properties": {
          "database": {
            "title": "Database",
            "type": "boolean"
          },
          "modules": {
            "items": {
              "$ref": "#/components/schemas/ModuleInfo"
            },
            "title": "Modules",
            "type": "array"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "database",
          "modules"
        ],
        "title": "HealthInfo",
        "type": "object"
      },
      "LogEntry": {
        "properties": {
          "exc": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exc"
          },
          "file": {
            "title": "File",
            "type": "string"
          },
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "logger": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Logger"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "ts": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ts"
          }
        },
        "required": [
          "source",
          "file",
          "ts",
          "level",
          "logger",
          "msg"
        ],
        "title": "LogEntry",
        "type": "object"
      },
      "LogFileInfo": {
        "properties": {
          "modified": {
            "format": "date-time",
            "title": "Modified",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "sizeBytes": {
            "title": "Sizebytes",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "sizeBytes",
          "modified"
        ],
        "title": "LogFileInfo",
        "type": "object"
      },
      "LogPage": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/LogEntry"
            },
            "title": "Entries",
            "type": "array"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "required": [
          "entries",
          "nextCursor"
        ],
        "title": "LogPage",
        "type": "object"
      },
      "LogSourceInfo": {
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/LogFileInfo"
            },
            "title": "Files",
            "type": "array"
          },
          "format": {
            "title": "Format",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "key",
          "title",
          "format",
          "available",
          "files"
        ],
        "title": "LogSourceInfo",
        "type": "object"
      },
      "ModuleInfo": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "icon": {
            "title": "Icon",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "order": {
            "title": "Order",
            "type": "integer"
          },
          "state": {
            "enum": [
              "loaded",
              "starting",
              "running",
              "failed",
              "disabled"
            ],
            "title": "State",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "key",
          "title",
          "icon",
          "order",
          "state"
        ],
        "title": "ModuleInfo",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
